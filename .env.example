# Discord bot token from the Discord Developer Portal.
DISCORD_BOT_TOKEN=your_bot_token_here

# Optional global notification channel ID. Per-channel targets can also be set
# with /settarget.
DISCORD_CHANNEL_ID=

# Prefix for legacy text commands.
BOT_PREFIX=!

# RSS polling interval in seconds. Minimum is 30.
POLL_INTERVAL=60

# HTTP request timeout in seconds.
HTTP_TIMEOUT=20
