# Discord bot token from the Discord Developer Portal.
DISCORD_BOT_TOKEN=your_bot_token_here

# Discord channel for YouTube alerts.
NOTIFICATION_CHANNEL_ID=

# Discord channel for server audit logs.
AUDIT_LOG_CHANNEL_ID=

# Optional legacy alias for NOTIFICATION_CHANNEL_ID.
DISCORD_CHANNEL_ID=

BOT_PREFIX=!
POLL_INTERVAL=60
HTTP_TIMEOUT=20

# Optional SQLite path. On Railway use /app/data/youtube_bot.db
# with a persistent volume mounted at /app/data.
DATABASE_PATH=youtube_bot.db
