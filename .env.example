# Discord bot token from the Discord Developer Portal.
DISCORD_BOT_TOKEN=your_bot_token_here

# Optional. If omitted, the bot uses the Discord Application Owner automatically.
BOT_OWNER_ID=

# Set true/1 only when you intentionally want a startup global slash-command sync.
# Normally leave this false and use the restricted /sync command after command changes.
SYNC_COMMANDS=false

# Optional SQLite path. On Railway use /app/data/youtube_bot.db
# with a persistent volume mounted at /app/data.
DATABASE_PATH=youtube_bot.db

# ---------------------------------------------------------------------------
# WebSub (PubSubHubbub) Push Engine — for near-instant YouTube notifications
# ---------------------------------------------------------------------------
# The publicly-reachable URL Google will POST new-upload notifications to.
# Must end with /youtube/webhook.
# On Railway: https://<your-app>.up.railway.app/youtube/webhook
# Leave empty to run in RSS-fallback-only mode (polls every 15 minutes).
WEBHOOK_URL=

# TCP port the embedded webhook HTTP server listens on.
# Railway auto-exposes this. Default: 8080
WEBHOOK_PORT=8080

# How often (seconds) the RSS safety-net fallback runs alongside WebSub.
# Default: 60 (every minute) — acts as active backup for missed pushes.
# Min: 60 (enforced in code).
FALLBACK_POLL_INTERVAL=60
